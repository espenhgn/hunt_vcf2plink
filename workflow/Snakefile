# Convert per-chromosome HUNT VCF files (GRCh37) to PLINK file sets in GRCh38,
# and project samples onto a reference PCA basis (HGDP+1KG).
#
# Steps per chromosome: VCF -> pgen (GRCh37) -> triple-liftOver -> GRCh38 (all variants)
#   -> SNPs aligned to the GRCh38 reference sequence; then merge and PCA projection.

from pathlib import Path


configfile: "config.yaml"


REPO_DIR = Path(workflow.basedir).parent
ROOT_DIR = Path(config.get("ROOT_DIR") or REPO_DIR)


def repo_path(p):
    """Resolve paths given relative to the repository root."""
    p = Path(p)
    return str(p if p.is_absolute() else ROOT_DIR / p)


_image = config["DOCKER"]
container: _image if "://" in _image else f"docker://{_image}"


OUT = Path(config["OUT_DIR"])
CHROMS = [str(c) for c in config["CHROMS"]]
STEM = config["FILE_STEM"]
MERGED_PREFIX = config["GENO_FILE_PREFIX"]
PLINK2 = config.get("PLINK2", "plink2")
SCRIPTS = Path(workflow.basedir) / "scripts"

# file set prefixes; {chr} in STEM becomes a wildcard
B37 = f"{OUT}/tmp/GRCh37/{STEM}"
LIFTED = f"{OUT}/tmp/GRCh38.lifted/{STEM}"
B38 = f"{OUT}/GRCh38/{STEM}"
ALIGNED = f"{OUT}/GRCh38.aligned/{STEM}"
MERGED = f"{OUT}/GRCh38.aligned/{MERGED_PREFIX}"
PCA = f"{OUT}/pca/{MERGED_PREFIX}"
QC = f"{OUT}/qc"
LOGS = f"{OUT}/logs"
WORK = f"{OUT}/tmp/work"

PGEN = (".pgen", ".pvar", ".psam")
BED = (".bed", ".bim", ".fam")


wildcard_constraints:
    chr=r"[0-9]+|X",


def res(rule, key):
    r = config["RESOURCES"]
    return r.get(rule, r["default"])[key]


def plink_mem(rule):
    """plink2 --memory sets the main workspace only; leave headroom."""
    return int(res(rule, "mem_mb") * 0.9)


def fileset(prefix, exts, **kw):
    return [prefix.format(**kw) + e for e in exts] if kw else multiext(prefix, *exts)


include: "rules/convert.smk"
include: "rules/liftover.smk"
include: "rules/align.smk"
include: "rules/merge.smk"
include: "rules/pca.smk"
include: "rules/report.smk"


rule all:
    input:
        [fileset(B38, PGEN + BED, chr=c) for c in CHROMS],
        [fileset(ALIGNED, PGEN, chr=c) for c in CHROMS],
        fileset(MERGED, PGEN + BED),
        f"{PCA}.pcs.tsv",
        f"{QC}/report.tsv",
